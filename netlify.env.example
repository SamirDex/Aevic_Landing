# Netlify → Site configuration → Environment variables → Import from .env
# Aşağıdakı YOUR_* hissələrini Supabase və öz şifrənizlə əvəz edin, sonra import edin.
# service_role key-i heç yerə paylaşmayın.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

VITE_ADMIN_ACCESS_KEY=turnir-admin-2026

# Email servisi (SMTP) - mütləq
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hebibovsamir26@gmail.com
SMTP_PASS=your_16_char_app_password

# Admin server key - mütləq
ADMIN_SERVER_KEY=turnir-admin-2026
